{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-interview-coach-api",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-23",
  "vars": {
    "AI_RUNTIME_MODE": "mock",
    "AI_INTERVIEW_MODEL": "REPLACE_WITH_WORKERS_AI_CHAT_MODEL",
    "AI_EVALUATION_MODEL": "REPLACE_WITH_WORKERS_AI_EVALUATION_MODEL",
    "AI_REPORT_MODEL": "REPLACE_WITH_WORKERS_AI_REPORT_MODEL"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INTERVIEW_SESSIONS",
        "class_name": "InterviewSessionDurableObject"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "interview-coach-db",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
      "preview_database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InterviewSessionDurableObject"]
    }
  ]
}
